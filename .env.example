# MongoDB Atlas or a local replica set is required for payment transactions.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/sportcenter?replicaSet=rs0
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Web checkout uses VNPay. Mobile payOS is selected by its API endpoint.
PAYMENT_MODE=vnpay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=http://localhost:5173/payment-result

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:5000/api/payments/payos/return
PAYOS_CANCEL_URL=http://localhost:5000/api/payments/payos/return

GOOGLE_CLIENT_ID=
GOOGLE_OTP_CHALLENGE_SECRET=replace_with_a_different_long_random_secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
